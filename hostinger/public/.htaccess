# grilla — reglas para Hostinger (LiteSpeed/Apache)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # API
  RewriteRule ^api/media/([A-Za-z0-9_-]+)$ api/media.php?id=$1 [QSA,L]
  RewriteRule ^api/uploads/([a-f0-9]{32})$ api/uploads.php?id=$1 [QSA,L]
  RewriteRule ^api/uploads/?$ api/uploads.php [QSA,L]
  RewriteRule ^api/export/metricas$ api/export.php [QSA,L]

  # Archivos internos: nunca se sirven directo
  RewriteRule ^(data|config\.php|config\.sample\.php) - [F,L]

  # Todo lo demás lo resuelve la app
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Los archivos de la app cambian de nombre en cada versión: se pueden cachear para siempre
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
